# Copier ce fichier en .env et renseigner les valeurs. Ne jamais versionner .env.
PORT=3000

# Fournisseur de l'assistant : gemini ou claude.
AI_PROVIDER=gemini

# Clé du fournisseur choisi. Elle reste uniquement sur le serveur.
#   Gemini : https://aistudio.google.com/apikey
#   Claude : https://console.anthropic.com
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Modèle (facultatif). Par défaut : gemini-3.8-flash ou claude-opus-5-5.
AI_MODEL=
# Modèle de secours si le principal est saturé (Gemini). Par défaut : gemini-3.5-flash-lite.
AI_FALLBACK_MODEL=

# Origines autorisées (séparées par des virgules). Vide = toutes (développement).
CORS_ORIGIN=

# Requêtes autorisées par minute et par IP sur l'assistant.
ASSISTANT_RATE_LIMIT=10
